# Server-side collection only; never prefix these with NEXT_PUBLIC_.
SCRAPEBADGER_API_KEY=
BRIGHTDATA_API_KEY=
# Optional, used only by npm run data:translate -- --google.
GOOGLE_TRANSLATE_API_KEY=
# Optional: lets an external uptime monitor read /api/health (16+ random characters; set only in a secrets manager).
HEALTH_TOKEN=
# Optional: milliseconds between worker polls for queued collection jobs.
FORME_WORKER_INTERVAL_MS=

# --- Sign-in and hosted data (Supabase). See docs/accounts-setup.md.
# Safe to expose to the browser:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Owner's computer ONLY (used by `npm run publish`). Never set this, or any provider key, on a hosting platform.
SUPABASE_SERVICE_ROLE_KEY=
# Set to 1 to require sign-in even when running on this computer.
FORME_REQUIRE_AUTH=
# Set to 1 only after enabling Google in Supabase; otherwise the login page shows email links only.
FORME_GOOGLE_SIGNIN=
