{
  "name": "forme-v2",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "test": "playwright test",
    "data:refresh": "node scripts/data/refresh-listings.mjs",
    "data:audit": "node scripts/data/audit-data.mjs",
    "data:translate": "node scripts/data/translate-listings.mjs",
    "data:import": "node scripts/data/import-database.mjs",
    "data:discovery-plan": "node scripts/data/discovery-plan.mjs",
    "data:discover": "node scripts/data/collect-discover.mjs",
    "worker": "node scripts/ops/worker.mjs",
    "brands:resolve": "node scripts/ops/resolve-brands.mjs",
    "data:coverage": "node scripts/data/data-coverage.mjs",
    "backup": "node scripts/ops/backup.mjs",
    "restore": "node scripts/ops/restore.mjs",
    "backup:drill": "node scripts/ops/backup-drill.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "check:secrets": "node scripts/ops/check-secrets.mjs",
    "env:check": "node scripts/ops/check-env.mjs",
    "publish": "node scripts/ops/publish-snapshot.mjs",
    "auth:check": "node scripts/ops/check-supabase.mjs",
    "recommendations:setup": "python3 scripts/lab/setup-recommendations.py",
    "recommendations:prepare": "node scripts/lab/prepare-recommendations.mjs",
    "recommendations:compare": ".context/recommendation-lab/.venv/bin/python scripts/lab/compare_recommendations.py --gorse-bin .context/recommendation-lab/bin/gorse-in-one",
    "recommendations:review:build": "node scripts/lab/review-recommendations.mjs",
    "recommendations:review": "node scripts/lab/serve-review.mjs",
    "test:recommendations": "node --test tests/unit/recommendation-evaluation.test.mjs tests/lab/recommendation-review.test.mjs && .context/recommendation-lab/.venv/bin/python -m unittest discover -s tests/lab -p \"test_*.py\"",
    "format:ui": "prettier --write \"components/**/*.tsx\" app/globals.css lib/domain/presentation.mjs",
    "check:format:ui": "prettier --check \"components/**/*.tsx\" app/globals.css lib/domain/presentation.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "3.9.10",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
